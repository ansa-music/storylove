# Справочник переменных окружения проекта. Здесь только имена и пояснения, значений нет.
#
# Локально Worker читает переменные из файла .dev.vars (см. .dev.vars.example; создаётся командой
# npm run setup:local). Файл .env проекту не обязателен и в git не попадает.
#
# В боевой среде секреты НЕ хранятся в файлах. Они задаются командой
#   npx wrangler secret put ИМЯ
# (SESSION_PEPPER, SETUP_TOKEN, R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY),
# а несекретные настройки (UPLOAD_MODE, PUBLIC_ORIGIN) — в разделе "vars" файла wrangler.jsonc.

# Секрет. Добавка к хэшам паролей и токенов сессий; случайная строка не короче 32 байт.
# Откуда: сгенерировать самому. После запуска сайта не менять.
SESSION_PEPPER=

# Секрет. Одноразовый токен первичной настройки для создания первого администратора на /admin/login.
# Откуда: сгенерировать самому.
SETUP_TOKEN=

# Секрет. Идентификатор аккаунта Cloudflare (для режима загрузки presign).
# Откуда: панель Cloudflare -> R2 -> Overview -> Account ID.
R2_ACCOUNT_ID=

# Секрет. Ключ доступа к R2 по S3 API (для режима загрузки presign).
# Откуда: панель Cloudflare -> R2 -> Manage R2 API Tokens -> Create API Token, поле Access Key ID.
R2_ACCESS_KEY_ID=

# Секрет. Секретная часть того же ключа; показывается один раз при создании токена.
R2_SECRET_ACCESS_KEY=

# Настройка. Способ загрузки видео: binding (локально и в тестах) или presign (боевой режим).
UPLOAD_MODE=

# Настройка. Публичный адрес сайта без косой черты в конце (вида https://домен).
PUBLIC_ORIGIN=
