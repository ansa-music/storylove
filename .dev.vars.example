# Пример файла .dev.vars — секреты и настройки для ЛОКАЛЬНОЙ разработки (wrangler / vite dev).
# Здесь только имена и пояснения, значений нет. Настоящий .dev.vars в git не попадает.
#
# Самый простой способ: npm run setup:local — создаст .dev.vars со случайными значениями сам.
#
# В боевой среде файл не используется. Секреты задаются командой
#   npx wrangler secret put ИМЯ
# а несекретные настройки (UPLOAD_MODE, PUBLIC_ORIGIN) — в разделе "vars" файла wrangler.jsonc.

# Секретная добавка к хэшам паролей и токенов сессий. Случайная строка, не короче 32 байт.
# Откуда: сгенерировать, например: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Менять нельзя: после смены все пароли и сессии перестанут подходить.
SESSION_PEPPER=

# Одноразовый токен первичной настройки: вводится на /admin/login при создании первого администратора.
# Откуда: сгенерировать так же, как SESSION_PEPPER (достаточно 24 байт).
SETUP_TOKEN=

# Идентификатор аккаунта Cloudflare. Нужен только в режиме UPLOAD_MODE=presign.
# Откуда: панель Cloudflare -> R2 -> Overview, поле Account ID.
R2_ACCOUNT_ID=

# Ключ доступа к R2 по S3 API. Нужен только в режиме UPLOAD_MODE=presign.
# Откуда: панель Cloudflare -> R2 -> Manage R2 API Tokens -> Create API Token
# (права Object Read & Write, только на бакет с видео). Поле Access Key ID.
R2_ACCESS_KEY_ID=

# Секретная часть того же ключа. Показывается один раз при создании токена — поле Secret Access Key.
R2_SECRET_ACCESS_KEY=

# Способ загрузки видео:
#   binding — части файла идут потоком через Worker; для локальной разработки и тестов, ключи R2 не нужны;
#   presign — части идут из браузера прямо в R2 по краткоживущим ссылкам; боевой режим, нужны три ключа R2 выше.
UPLOAD_MODE=

# Публичный адрес сайта без косой черты в конце (вида https://домен). Используется в ссылках,
# sitemap и метаданных страниц. Локально можно оставить пустым.
PUBLIC_ORIGIN=
