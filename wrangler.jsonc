{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "storylove",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Worker запускается первым только там, где нужна серверная логика
    // (API, выдача медиа, HTML с метаданными и заголовками безопасности).
    // Статические файлы сборки (/assets/*) отдаются напрямую и не тратят лимит запросов Worker.
    "run_worker_first": [
      "/",
      "/api/*",
      "/media/*",
      "/watch/*",
      "/about",
      "/admin",
      "/admin/*",
      "/sitemap.xml",
      "/robots.txt"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "storylove",
      "database_id": "7c846caf-ff9d-41d0-8876-e64b5ec51aa7",
      "migrations_dir": "db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "storylove-media"
    }
  ],
  "vars": {
    // "presign" — части видео идут из браузера прямо в R2 по краткоживущим ссылкам.
    // "binding" — части идут потоком через Worker (локальная разработка и тесты).
    // "auto"    — presign, как только заданы секреты R2_*; до этого binding.
    "UPLOAD_MODE": "auto",
    "R2_BUCKET_NAME": "storylove-media",
    "PUBLIC_ORIGIN": ""
  }
  // Секреты (wrangler secret put …): SESSION_PEPPER, SETUP_TOKEN,
  // R2_ACCOUNT_ID, R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY

  // Временный выпуск без хранилища, пока в аккаунте не включён R2:
  //   CLOUDFLARE_ENV=nostorage npm run build && wrangler deploy
  // Публичная страница работает, загрузка видео и изображений — нет.
  // Имя Worker то же, поэтому обычный `npm run deploy` потом заменит этот выпуск.
  ,
  "env": {
    "nostorage": {
      "name": "storylove",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "storylove",
          "database_id": "7c846caf-ff9d-41d0-8876-e64b5ec51aa7",
          "migrations_dir": "db/migrations"
        }
      ],
      "vars": {
        "UPLOAD_MODE": "auto",
        "R2_BUCKET_NAME": "storylove-media",
        "PUBLIC_ORIGIN": ""
      }
    }
  }
}
